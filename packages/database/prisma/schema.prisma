generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  sessions         Session[]
  accounts         Account[]
  userProfile      userProfile?
  oauthClient      oauthClient[]
  oauthGrantToken  oauthGrantToken[]
  oauthAccessToken oauthAccessToken[]
  codeChallenge    codeChallenge[]
  completedSignup  String             @default("false")
  resumeTags       resumeTags[]
  userResume       userResume[]
  resumeLink       resumeLink[]
  profileLink      profileLink[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum VISIBILITY {
  PUBLIC
  PRIVATE
}

// used for user profile page. user can sets a public profile which is searchable
model userProfile {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerText String     @default("Welcome to my profile (edit it)")
  visibility VISIBILITY
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("user_profile")
}

model profileLink {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility    VISIBILITY
  resumeTagName String // eg. "devops"
  linkId        String     @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("profile_link")
}

model userResume {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId  String // ID of document stored in mongoDB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_resume")
}

model resumeTags {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeTagName String // eg. "devops"
  visibility    VISIBILITY
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("resume_tags")
}

model resumeLink {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeTagName String // eg. "devops"
  visibility    VISIBILITY
  linkId        String     @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("resume_link")
}

// !             oAuth tables         // 
model oauthClient {
  clientId         String             @id @default(cuid())
  clientSecret     String             @unique
  redirect_uri     String
  image            String?
  name             String
  description      String?
  website          String?
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  oauthGrantToken  oauthGrantToken[]
  oauthAccessToken oauthAccessToken[]
  codeChallenge    codeChallenge[]

  @@map("oauth_client")
}

model oauthGrantToken {
  id              String        @id @default(cuid())
  grantToken      String        @unique
  scope           String // space delimited tags name eg, "devops marketing webdev"
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthclientId   String
  oauthClient     oauthClient   @relation(fields: [oauthclientId], references: [clientId], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  codeChallengeId String        @unique
  codeChallenge   codeChallenge @relation(fields: [codeChallengeId], references: [id], onDelete: Cascade)

  @@map("oauth_grant_token")
}

model oauthAccessToken {
  id            String      @id @default(cuid())
  accessToken   String      @unique
  scope         String // copy scope from oauth_auth_token table after token generation
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  oauthclientId String
  oauthClient   oauthClient @relation(fields: [oauthclientId], references: [clientId], onDelete: Cascade)

  @@map("oauth_access_token")
}

model codeChallenge {
  id                  String           @id @default(cuid())
  codeChallenge       String           @unique
  codeChallengeMethod String
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  oauthGrantToken     oauthGrantToken?
  oauthClientId       String
  oauthClient         oauthClient      @relation(fields: [oauthClientId], references: [clientId], onDelete: Cascade)

  @@map("code_challenge")
}

model waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model contactUs {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_us")
}
