{
  "$schema": "https://anisharaz.github.io/centralresume/eng_resume.json",
  "title": "ENGINEERING_RESUME",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "personal_details": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tag_line": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["text", "tags"]
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["text", "tags"]
          }
        },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "date_of_birth": { "type": "string", "format": "date" },
        "address": {
          "type": "object",
          "properties": {
            "address_line": { "type": "string" },
            "city": { "type": "string" },
            "country": { "type": "string" }
          },
          "required": ["address_line", "city", "country"]
        },
        "social_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "url", "tags"]
          }
        }
      },
      "required": ["name", "email"]
    },
    "work_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "position": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          },
          "website": { "type": "string", "format": "uri" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          }
        },
        "required": [
          "company",
          "tags",
          "position",
          "start_date",
          "summary",
          "highlights"
        ]
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "soft": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "level": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "tags"]
          }
        },
        "technical": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "level": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "tags"]
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "date": { "type": "string", "format": "date" },
          "awarded_by": { "type": "string" },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          }
        },
        "required": ["title", "tags", "date"]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "field": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          },
          "degree_level": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "score": { "type": "string" }
        },
        "required": [
          "institution",
          "tags",
          "field",
          "degree_level",
          "startDate",
          "endDate",
          "score"
        ]
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "publisher": { "type": "string" },
          "releaseDate": { "type": "string", "format": "date" },
          "url": { "type": "string", "format": "uri" },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          }
        },
        "required": ["name", "tags", "publisher", "releaseDate", "url"]
      }
    },
    "otherLists": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "heading": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["text", "tags"]
            }
          }
        },
        "required": ["tags", "heading", "summary"]
      }
    }
  },
  "required": ["version", "personal_details"]
}
