generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  sessions         Session[]
  accounts         Account[]
  userProfile      userProfile?
  oauthClient      oauthClient[]
  oauthGrantToken  oauthGrantToken[]
  oauthAccessToken oauthAccessToken[]
  codeChallenge    codeChallenge[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum VISIBILITY {
  PUBLIC
  PRIVATE
}

// used for user profile page. user can sets a public profile which is searchable
model userProfile {
  id           String     @id
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImage String?
  bannerImage  String?
  visibility   VISIBILITY
  createdAt    DateTime
  updatedAt    DateTime

  @@map("user_profile")
}

// !             oAuth tables         // 
model oauthClient {
  clientId         String             @id
  clientSecret     String             @unique
  redirect_uri     String
  image            String?
  name             String
  description      String?
  website          String?
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime
  updatedAt        DateTime
  oauthGrantToken  oauthGrantToken[]
  oauthAccessToken oauthAccessToken[]
  codeChallenge    codeChallenge[]

  @@map("oauth_client")
}

model oauthGrantToken {
  id              String        @id
  grantToken      String        @unique
  scope           String // space delimited tags name eg, "devops marketing webdev"
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthclientId   String
  oauthClient     oauthClient   @relation(fields: [oauthclientId], references: [clientId], onDelete: Cascade)
  createdAt       DateTime
  updatedAt       DateTime
  codeChallengeId String        @unique
  codeChallenge   codeChallenge @relation(fields: [codeChallengeId], references: [id], onDelete: Cascade)

  @@map("oauth_grant_token")
}

model oauthAccessToken {
  id            String      @id
  accessToken   String      @unique
  scope         String // copy scope from oauth_auth_token table after token generation
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime
  updatedAt     DateTime
  oauthclientId String
  oauthClient   oauthClient @relation(fields: [oauthclientId], references: [clientId], onDelete: Cascade)

  @@map("oauth_access_token")
}

model codeChallenge {
  id                  String           @id
  codeChallenge       String           @unique
  codeChallengeMethod String
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime
  updatedAt           DateTime
  oauthGrantToken     oauthGrantToken?
  oauthClientId       String
  oauthClient         oauthClient      @relation(fields: [oauthClientId], references: [clientId], onDelete: Cascade)

  @@map("code_challenge")
}
